{
  "all": true,
  "include": [
    "core/**/*.{ts,js,mjs}",
    "runtime/**/*.{ts,js,mjs}",
    "renderers/**/*.ts",
    "themes/**/*.ts",
    "site/**/*.ts",
    "scripts/**/*.{ts,js,mjs}",
    "lib/**/*.js",
    "authoring/**/*.js",
    "infrastructure/**/*.js",
    "processLinks.js",
    "prototypes/ink-and-paper/{src,scripts,worker}/**/*.{js,mjs,jsx}",
    "tools/code-analysis/**/*.mjs"
  ],
  "exclude": ["**/*.d.ts", "**/*.test.*"],
  "extension": [".js", ".mjs", ".ts", ".jsx"],
  "reporter": ["text-summary", "json", "json-summary", "html", "lcov"],
  "reports-dir": "coverage/javascript",
  "check-coverage": true,
  "lines": 80,
  "statements": 80,
  "functions": 80,
  "branches": 70
}
