{
  "name": "danilop-personal-page",
  "version": "1.0.0",
  "description": "Notes Along the Way \u2014 articles, collections, books, and interactive explanations",
  "main": "processLinks.js",
  "engines": {
    "node": ">=22.19"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@aws-sdk/client-amplify": "^3.1133.0",
    "@aws-sdk/client-cloudfront": "^3.1133.0",
    "@aws-sdk/client-cloudfront-keyvaluestore": "^3.1133.0",
    "@aws-sdk/client-s3": "^3.1133.0",
    "@aws-sdk/credential-providers": "^3.1133.0",
    "@citation-js/core": "^0.8.2",
    "@citation-js/plugin-bibtex": "^0.8.2",
    "@citation-js/plugin-csl": "^0.8.2",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0",
    "@mermaid-js/mermaid-cli": "^11.17.0",
    "@mlc-ai/web-llm": "^0.2.85",
    "@terrastruct/d2": "^0.1.33",
    "@types/katex": "^0.16.8",
    "@types/node": "^22.20.3",
    "@types/unist": "^3.0.3",
    "astro": "^7.3.2",
    "cheerio": "1.0.0-rc.12",
    "csv-parse": "^7.0.2",
    "fs-extra": "^8.1.0",
    "gray-matter": "^4.0.3",
    "katex": "^0.18.7",
    "open-graph-scraper": "^4.6.0",
    "rehype-katex": "^7.0.1",
    "rehype-parse": "^9.0.1",
    "rehype-remark": "^10.0.1",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "remark-stringify": "^11.0.0",
    "sharp": "^0.35.4",
    "shiki": "^4.4.3",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vega": "^6.4.0",
    "vega-lite": "^6.4.3",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "scripts": {
    "dev": "node --import tsx scripts/prepare.ts && astro dev --host 127.0.0.1",
    "build": "node --import tsx scripts/prepare.ts && astro build && node --import tsx scripts/verify-build.ts",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro check && tsc --noEmit -p tsconfig.core.json",
    "build:legacy": "node processLinks.js data static src public cache",
    "sync:posts": "node scripts/sync-posts.js",
    "test": "node --test test/*.test.js && node --import tsx --test test/*.test.ts",
    "book": "node --import tsx scripts/book.ts",
    "distribute": "node --import tsx scripts/distribute.ts",
    "publish:links": "node --import tsx scripts/publish-links.ts",
    "leanpub": "node --import tsx scripts/leanpub.ts"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/mdast": "^4.0.4",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^1.0.0"
  }
}
