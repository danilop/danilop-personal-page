{
  "name": "danilop-personal-page",
  "version": "1.0.0",
  "description": "Notes Along the Way \u2014 articles, collections, books, and interactive explanations",
  "main": "processLinks.js",
  "engines": {
    "node": ">=24.21.0 <25",
    "npm": ">=12.2.0 <13"
  },
  "packageManager": "npm@12.2.0",
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@aws-sdk/client-amplify": "^3.1144.0",
    "@aws-sdk/client-cloudfront": "^3.1144.0",
    "@aws-sdk/client-s3": "^3.1144.0",
    "@citation-js/core": "^0.9.0",
    "@citation-js/plugin-bibtex": "^0.9.0",
    "@citation-js/plugin-csl": "^0.9.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0",
    "@mermaid-js/mermaid-cli": "^12.0.0",
    "@mlc-ai/web-llm": "^0.2.85",
    "@terrastruct/d2": "^0.1.33",
    "@types/katex": "^0.16.8",
    "@types/node": "^24.19.0",
    "@types/unist": "^3.0.3",
    "astro": "^7.3.5",
    "cheerio": "^1.2.0",
    "csv-parse": "^7.0.3",
    "fs-extra": "^11.4.1",
    "gray-matter": "^4.0.3",
    "katex": "^0.19.0",
    "open-graph-scraper": "^6.12.0",
    "posthog-js": "^1.435.6",
    "rehype-katex": "^7.0.1",
    "rehype-parse": "^9.0.1",
    "rehype-remark": "^10.0.1",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "remark-stringify": "^11.0.0",
    "sharp": "^0.35.5",
    "shiki": "^4.5.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vega": "^6.4.0",
    "vega-lite": "^6.4.3",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "scripts": {
    "assets:prepare": "node --import tsx scripts/prepare-assets.ts",
    "assets:provision-cleanup": "node --import tsx scripts/provision-asset-cleanup.ts",
    "release": "node --import tsx scripts/release.ts",
    "dev": "node --import tsx scripts/prepare.ts && astro dev --host 127.0.0.1",
    "build": "npm run prepare:site && npm run build:prepared",
    "preview": "node scripts/preview-site.mjs",
    "check": "astro check && tsc --noEmit -p tsconfig.core.json",
    "build:legacy": "node processLinks.js data static src public cache",
    "sync:posts": "node scripts/sync-posts.js",
    "test": "npm --prefix prototypes/ink-and-paper run build && node tools/code-analysis/test-node.mjs",
    "book": "node --import tsx scripts/book.ts",
    "distribute": "node --import tsx scripts/distribute.ts",
    "publish:links": "node --import tsx scripts/publish-links.ts",
    "leanpub": "node --import tsx scripts/leanpub.ts",
    "prepare:site": "node --import tsx scripts/prepare.ts",
    "build:prepared": "astro build && node --import tsx scripts/package-site.ts && node --import tsx scripts/verify-build.ts",
    "validate": "npm test && npm run prepare:site && npm run check && npm run build:prepared",
    "article:publish": "node --import tsx scripts/publish-article.ts",
    "verify:deployment": "node scripts/verify-deployment.mjs",
    "verify:social": "node --import tsx scripts/verify-social.ts",
    "media": "node --import tsx scripts/media.ts",
    "media:provision": "node --import tsx scripts/provision-media.ts",
    "tags": "node --import tsx scripts/tags.ts",
    "quality:setup": "node scripts/setup-quality.mjs",
    "quality": "node --import tsx scripts/quality.ts",
    "test:quality": ".venv-quality/bin/python -m unittest discover -s tools/content-quality -p \"test_*.py\"",
    "prepublish:check": "node --import tsx scripts/quality.ts --validate",
    "content:import": "node --import tsx scripts/import-content.ts",
    "analysis:setup": "node tools/code-analysis/setup.mjs",
    "verify:commit": "node tools/code-analysis/pre-commit.mjs",
    "verify:worktree": "node tools/code-analysis/pre-commit.mjs --worktree",
    "verify:static": "node tools/code-analysis/pre-commit.mjs --worktree --static",
    "verify:ci": "node tools/code-analysis/pre-commit.mjs --worktree --ci",
    "test:coverage": "node tools/code-analysis/run.mjs coverage",
    "assets:cleanup": "node --import tsx scripts/cleanup-assets.ts"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@eslint-react/eslint-plugin": "5.23.3",
    "@eslint/js": "10.0.1",
    "@types/mdast": "^4.0.4",
    "c8": "12.0.0",
    "dependency-cruiser": "18.5.0",
    "eslint": "10.11.0",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-html": "8.2.1",
    "eslint-plugin-jsonc": "3.4.2",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-sonarjs": "4.2.2",
    "eslint-plugin-yml": "3.8.1",
    "globals": "17.13.0",
    "html-validate": "11.16.1",
    "knip": "6.39.0",
    "linkedom": "^0.18.13",
    "playwright": "^1.63.0",
    "postcss-html": "2.0.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "puppeteer": "25.12.0",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0",
    "typescript-eslint": "8.71.0"
  },
  "allowScripts": {
    "core-js@3.50.0": false,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "puppeteer@25.12.0": true
  },
  "overrides": {
    "lodash-es": "4.18.1"
  }
}
