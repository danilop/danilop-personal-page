flowchart TB
  agent("Visiting agent")
  assistant("On-device assistant")
  webmcp["WebMCP in the browser"]
  subgraph page["This page"]
    acting["Action tools<br/>go to, play, run"]
    reading["Reading tools<br/>outline, sections, find"]
    controls["Visible controls<br/>links, Play, Run"]
    notice["Notice with Undo"]
    text@{ shape: doc, label: "Article text" }
  end
  reader("Reader")
