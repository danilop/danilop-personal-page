  webmcp --> acting
  webmcp --> reading
  assistant -->|"calls directly"| reading
  acting -->|"presses"| controls
  acting -->|"announces"| notice
  reading -->|"reads"| text
  controls ~~~ reader
  reader -->|"clicks"| controls
  reader -->|"can undo"| notice
