---
import DraftBadge from "../../site/components/DraftBadge.astro";
import Layout from "../../site/components/Layout.astro";
import { dateLabel } from "../../site/data";
import type { ArticleData } from "../../core/site-data";
import TagList from "../../site/components/TagList.astro";
import ArticleSharing from "../../site/components/ArticleSharing.astro";
import NarrationPlayer from "../../site/components/NarrationPlayer.astro";
import AssistantEntry from "../../site/components/AssistantEntry.astro";
import { searchContext } from "../../core/reading-index";
interface Props {
  article: ArticleData;
}
const { article } = Astro.props;
---

<Layout
  title={article.title}
  description={article.summary}
  canonical={article.url}
  article={article}
>
  <article class="reading">
    <header class="article-heading">
      <p class="eyebrow">
        <a href="/writing/">Writing</a>
      </p>
      <h1>
        {article.title} <DraftBadge pieceId={article.id} />
      </h1>
      <p class="dek">{article.summary}</p>
      <div class="article-meta-row">
        <p class="meta">
          {article.publishedAt && (
            <>
              <time datetime={article.publishedAt}>
                {dateLabel(article.publishedAt)}
              </time>
              {" · "}
            </>
          )}
          {article.minutes} min read
          {article.updatedAt && (
            <>
              {" "}
              · Updated{" "}
              <time datetime={article.updatedAt}>
                {dateLabel(article.updatedAt)}
              </time>
            </>
          )}
        </p>
        <ArticleSharing
          pieceId={article.id}
          title={article.title}
          url={article.url}
          position="top"
        />
      </div>
    </header>
    <NarrationPlayer narration={article.narration} title={article.title} />
    <AssistantEntry />
    <div
      class="prose"
      data-pagefind-body
      data-pagefind-meta="title[data-title], context[data-context], date[data-date]"
      data-title={article.title}
      data-context={searchContext("Article", article.collections)}
      data-date={article.publishedAt ? dateLabel(article.publishedAt) : ""}
      set:html={article.html}
    />
    <TagList tags={article.tags} />
    <ArticleSharing
      pieceId={article.id}
      title={article.title}
      url={article.url}
      position="bottom"
    />
    {article.collections.length > 0 && (
      <aside class="memberships">
        <h2>Continue exploring</h2>
        <ul>
          {article.collections.map((c) => (
            <li>
              <a href={c.url}>{c.title}</a>
            </li>
          ))}
        </ul>
      </aside>
    )}
    <a class="back-link" href="/writing/">
      All writing
    </a>
  </article>
</Layout>
<style>
  .article-meta-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 18px;
    margin-top: 14px;
  }

  .article-meta-row .meta {
    margin: 0;
  }
</style>
