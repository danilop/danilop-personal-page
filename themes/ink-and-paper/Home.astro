---
import DraftBadge from "../../site/components/DraftBadge.astro";
import { homepageSelection } from "../../core/homepage";
import { dateLabel } from "../../site/data";
import type { CompiledSite } from "../../core/site-data";
import type { SiteConfig } from "../../core/config";
interface Props {
  site: CompiledSite;
  config: SiteConfig;
}
const { site, config } = Astro.props;
const { lead, recent, featured } = homepageSelection(site);
const collections = site.home.collections.length
  ? site.home.collections.map((id) =>
      site.collections.find((c) => c.id === id)!,
    )
  : site.collections.slice(0, 3);
const history = site.archive.filter((r) => r.kind === "posts").slice(0, 4);
---

<div
  class:list={[
    "front-page",
    { linear: config.layout === "linear", "single-story": recent.length === 0 },
  ]}
>
  {lead && (
    <article class="lead">
      <p class="eyebrow">{featured ? "Featured" : "Latest"}</p>
      {lead.context && <p class="eyebrow">{lead.context}</p>}
      <h1>
        <a href={lead.url}>{lead.title}</a>
        <DraftBadge
          pieceId={lead.kind === "piece" ? lead.id : undefined}
          collectionId={lead.kind === "collection" ? lead.id : undefined}
        />
      </h1>
      <p class="lead-summary">{lead.summary}</p>
      <p class="meta">
        {lead.publishedAt && (
          <time datetime={lead.publishedAt}>{dateLabel(lead.publishedAt)}</time>
        )}
        {lead.minutes && (
          <span>
            {lead.publishedAt ? " · " : ""}
            {lead.minutes} min read
          </span>
        )}
      </p>
      {lead.image && (
        <a
          href={lead.url}
          class:list={[
            "article-art",
            { "cover-art": lead.kind === "collection" },
          ]}
        >
          <img
            src={lead.image.src}
            alt={lead.image.alt}
            width={lead.image.width}
            height={lead.image.height}
            fetchpriority="high"
          />
        </a>
      )}
      <a class="read-link" href={lead.url}>
        {lead.kind === "collection" ? "Start reading" : "Read the article"}{" "}
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M4 12h15m-6-6 6 6-6 6" />
        </svg>
      </a>
    </article>
  )}
  {recent.length > 0 && (
    <section class="recent" aria-labelledby="recent-heading">
      <h2 id="recent-heading" class="section-label">
        More writing
      </h2>
      {recent.map((p) => (
        <article>
          {p.context && <p class="eyebrow">{p.context}</p>}
          <h3>
            <a href={p.url}>{p.title}</a> <DraftBadge pieceId={p.id} />
          </h3>
          <p>{p.summary}</p>
          <p class="meta">
            {p.publishedAt && (
              <time datetime={p.publishedAt}>{dateLabel(p.publishedAt)}</time>
            )}
          </p>
        </article>
      ))}
      <a class="read-link" href="/writing/">
        Browse all posts
      </a>
    </section>
  )}
</div>
{collections.length > 0 && (
  <section class="collections-section">
    <div class="section-heading">
      <h2>Collections & Books</h2>
      <a href="/collections/">Browse all</a>
    </div>
    <div class="collection-grid">
      {collections.map((c) => (
        <article>
          <p class="eyebrow">{c.book ? "Book" : "Collection"}</p>
          <h3>
            <a href={c.url}>{c.title}</a> <DraftBadge collectionId={c.id} />
          </h3>
          <p>{c.summary}</p>
          <a class="read-link" href={c.url}>
            Explore collection
          </a>
        </article>
      ))}
    </div>
  </section>
)}
{site.elsewhere.length > 0 && site.home.elsewhereCount > 0 && (
  <section class="history-section">
    <div class="section-heading">
      <h2>Elsewhere</h2>
    </div>
    <div class="history-grid">
      {site.elsewhere.slice(0, site.home.elsewhereCount).map((r) => (
        <article>
          <p class="eyebrow">{r.publisher}</p>
          <h3>
            <a href={r.url}>{r.title}</a>
          </h3>
          <p class="meta">{r.publishedAt && dateLabel(r.publishedAt)}</p>
        </article>
      ))}
    </div>
  </section>
)}
{history.length > 0 && (
  <section class="history-section">
    <div class="section-heading">
      <div>
        <h2>Earlier Work</h2>
        <p>Articles, talks, and videos from before this new chapter.</p>
      </div>
      <a href="/archive/">Browse the archive</a>
    </div>
    <div class="history-grid">
      {history.map((r) => (
        <article>
          <p class="eyebrow">{r.publisher}</p>
          <h3>
            <a href={r.url}>{r.title}</a>
          </h3>
          {r.publishedAt && (
            <p class="meta">
              <time datetime={r.publishedAt}>{dateLabel(r.publishedAt)}</time>
            </p>
          )}
        </article>
      ))}
    </div>
  </section>
)}
