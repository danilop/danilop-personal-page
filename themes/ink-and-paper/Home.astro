---
import { dateLabel } from "../../site/data";
import type { CompiledSite } from "../../core/site-data";
import type { SiteConfig } from "../../core/config";
interface Props {
  site: CompiledSite;
  config: SiteConfig;
}
const { site, config } = Astro.props;
const lead =
  site.articles.find((p) => p.id === site.home.lead) ?? site.articles[0];
const recent = site.articles
  .filter((p) => p.id !== lead?.id)
  .slice(0, site.home.recentCount);
const collections = site.home.collections.length
  ? site.home.collections.map((id) =>
      site.collections.find((c) => c.id === id)!,
    )
  : site.collections.slice(0, 3);
const history = site.archive.filter((r) => r.kind === "posts").slice(0, 4);
---

<div
  class:list={[
    "front-page",
    { linear: config.layout === "linear", "single-story": recent.length === 0 },
  ]}
>
  {lead && (
    <article class="lead">
      <p class="eyebrow">{site.home.lead ? "Featured" : "Latest"}</p>
      <h1>
        <a href={lead.url}>{lead.title}</a>
      </h1>
      <p class="lead-summary">{lead.summary}</p>
      <p class="meta">
        <time datetime={lead.publishedAt}>{dateLabel(lead.publishedAt)}</time>
        <span> · {lead.minutes} min read</span>
      </p>
      {config.assets.hero && (
        <a href={lead.url} class="article-art" tabindex="-1" aria-hidden="true">
          <img
            src="/brand/hero.webp"
            alt=""
            width="1200"
            height="430"
            fetchpriority="high"
          />
        </a>
      )}
      <a class="read-link" href={lead.url}>
        Read the article{" "}
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M4 12h15m-6-6 6 6-6 6" />
        </svg>
      </a>
    </article>
  )}
  {recent.length > 0 && (
    <section class="recent" aria-labelledby="recent-heading">
      <h2 id="recent-heading" class="section-label">
        More writing
      </h2>
      {recent.map((p) => (
        <article>
          <h3>
            <a href={p.url}>{p.title}</a>
          </h3>
          <p>{p.summary}</p>
          <p class="meta">
            <time datetime={p.publishedAt}>{dateLabel(p.publishedAt)}</time>
          </p>
        </article>
      ))}
    </section>
  )}
</div>
{collections.length > 0 && (
  <section class="collections-section">
    <div class="section-heading">
      <h2>Collections & Books</h2>
      <a href="/collections/">Browse all</a>
    </div>
    <div class="collection-grid">
      {collections.map((c) => (
        <article>
          <p class="eyebrow">{c.book ? "Growing book" : "Collection"}</p>
          <h3>
            <a href={c.url}>{c.title}</a>
          </h3>
          <p>{c.summary}</p>
          <a class="read-link" href={c.url}>
            Explore collection
          </a>
        </article>
      ))}
    </div>
  </section>
)}
{site.elsewhere.length > 0 && site.home.elsewhereCount > 0 && (
  <section class="history-section">
    <div class="section-heading">
      <h2>Elsewhere</h2>
    </div>
    <div class="history-grid">
      {site.elsewhere.slice(0, site.home.elsewhereCount).map((r) => (
        <article>
          <p class="eyebrow">{r.publisher}</p>
          <h3>
            <a href={r.url}>{r.title}</a>
          </h3>
          <p class="meta">{r.publishedAt && dateLabel(r.publishedAt)}</p>
        </article>
      ))}
    </div>
  </section>
)}
{history.length > 0 && (
  <section class="history-section">
    <div class="section-heading">
      <div>
        <h2>Earlier Work</h2>
        <p>Articles, talks, and videos from before this new chapter.</p>
      </div>
      <a href="/archive/">Browse the archive</a>
    </div>
    <div class="history-grid">
      {history.map((r) => (
        <article>
          <p class="eyebrow">{r.publisher}</p>
          <h3>
            <a href={r.url}>{r.title}</a>
          </h3>
          {r.publishedAt && (
            <p class="meta">
              <time datetime={r.publishedAt}>{dateLabel(r.publishedAt)}</time>
            </p>
          )}
        </article>
      ))}
    </div>
  </section>
)}
