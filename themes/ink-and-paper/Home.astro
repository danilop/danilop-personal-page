---
import DraftBadge from "../../site/components/DraftBadge.astro";
import WritingGroups from "../../site/components/WritingGroups.astro";
import { groupWriting } from "../../core/homepage";
import { discovery, type WritingPage } from "../../core/discovery";
import BookSummaries from "../../site/components/BookSummaries.astro";
import WritingPager from "../../site/components/WritingPager.astro";
import { dateLabel } from "../../site/data";
import type { CompiledSite } from "../../core/site-data";
import type { SiteConfig } from "../../core/config";
interface Props {
  site: CompiledSite;
  config: SiteConfig;
  page?: WritingPage;
}
const { site, config } = Astro.props;
const { lead, books, drafts, homePages } = discovery(site);
const page = Astro.props.page ?? homePages[0];
const draftGroups = groupWriting(drafts);
const leadContext = [
  lead?.readingLabel,
  lead?.context?.startsWith("New in ")
    ? "New instalment"
    : lead?.context?.startsWith("Introducing ")
      ? "Introducing the book"
      : undefined,
]
  .filter(Boolean)
  .join(" · ");
const history = site.archive.filter((r) => r.kind === "posts").slice(0, 4);
---

<div
  class:list={[
    "discovery-top",
    { "has-books": books.length > 0, linear: config.layout === "linear" },
  ]}
>
  {!lead && <h1>Writing</h1>}
  {lead && (
    <article class="discovery-lead">
      <div class="lead-copy">
        <p class="eyebrow">Latest</p>
        <p class="lead-membership">
          {lead.books?.some((book) => !book.draft)
            ? lead.books
                .filter((book) => !book.draft)
                .map((book) => <a href={book.url}>From {book.title}</a>)
            : "Article"}
        </p>
        {leadContext && <p class="meta">{leadContext}</p>}
        <h1 id="latest-heading">
          <a href={lead.url}>{lead.title}</a>
          <DraftBadge
            pieceId={lead.kind === "piece" ? lead.id : undefined}
            collectionId={lead.kind === "collection" ? lead.id : undefined}
          />
        </h1>
        <p class="lead-summary">{lead.summary}</p>
        <p class="meta">
          {lead.publishedAt && (
            <time datetime={lead.publishedAt}>
              {dateLabel(lead.publishedAt)}
            </time>
          )}
          {lead.minutes && (
            <span>
              {lead.publishedAt ? " · " : ""}
              {lead.minutes} min read
            </span>
          )}
          {lead.narration && (
            <span>
              {" "}
              · {Math.floor(lead.narration.duration / 1.1 / 60)}:
              {String(
                Math.floor((lead.narration.duration / 1.1) % 60),
              ).padStart(2, "0")}{" "}
              listen at 1.1×
            </span>
          )}
        </p>
        <a class="read-link" href={lead.url}>
          {lead.kind === "collection" ? "Start reading" : "Read the article"}{" "}
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M4 12h15m-6-6 6 6-6 6" />
          </svg>
        </a>
      </div>
      {lead.image && (
        <a
          href={lead.url}
          class:list={[
            "article-art",
            { "cover-art": lead.kind === "collection" },
          ]}
        >
          <img
            src={lead.image.src}
            alt={lead.image.alt}
            width={lead.image.width}
            height={lead.image.height}
            fetchpriority="high"
          />
        </a>
      )}
    </article>
  )}
  <BookSummaries books={books} />
</div>
<section class="recent-writing" aria-labelledby="recent-heading">
  <div class="section-heading">
    <h2 id="recent-heading">More articles</h2>
    <a href="/writing/">
      All writing <span aria-hidden="true">→</span>
    </a>
  </div>
  <WritingPager page={page} />
</section>
{draftGroups.length > 0 && (
  <section class="preview-drafts" aria-labelledby="drafts-heading">
    <div class="section-heading">
      <div>
        <h2 id="drafts-heading">Drafts in preview</h2>
        <p>
          Unpublished writing, grouped by book. Visible only in this local
          preview.
        </p>
      </div>
    </div>
    <WritingGroups groups={draftGroups} compact={false} />
  </section>
)}
{site.elsewhere.length > 0 && site.home.elsewhereCount > 0 && (
  <section class="history-section">
    <div class="section-heading">
      <h2>Elsewhere</h2>
    </div>
    <div class="history-grid">
      {site.elsewhere.slice(0, site.home.elsewhereCount).map((r) => (
        <article>
          <p class="eyebrow">{r.publisher}</p>
          <h3>
            <a href={r.url}>{r.title}</a>
          </h3>
          <p class="meta">{r.publishedAt && dateLabel(r.publishedAt)}</p>
        </article>
      ))}
    </div>
  </section>
)}
{history.length > 0 && (
  <section class="history-section">
    <div class="section-heading">
      <div>
        <h2>Earlier Work</h2>
        <p>Articles, talks, and videos from before this new chapter.</p>
      </div>
      <a href="/archive/">Browse the archive</a>
    </div>
    <div class="history-grid">
      {history.map((r) => (
        <article>
          <p class="eyebrow">{r.publisher}</p>
          <h3>
            <a href={r.url}>{r.title}</a>
          </h3>
          {r.publishedAt && (
            <p class="meta">
              <time datetime={r.publishedAt}>{dateLabel(r.publishedAt)}</time>
            </p>
          )}
        </article>
      ))}
    </div>
  </section>
)}
