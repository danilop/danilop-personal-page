---
import Header from "../../site/components/Header.astro";
import Footer from "../../site/components/Footer.astro";
import "../ink-and-paper/style.css";
const { config, collectionsCount } = Astro.props;
---

<div class="paper theme-plain">
  <Header config={config} collectionsCount={collectionsCount} />
  <main id="main">
    <slot />
  </main>
  <Footer config={config} />
</div>
<style is:global>
  .theme-plain {
    --serif: Georgia, serif;
    --paper: #fff;
    --blue: #333;
  }
  .theme-plain .identity .name {
    font-size: clamp(2.2rem, 6vw, 4.2rem);
  }
  .theme-plain .portrait-link {
    display: none;
  }
  .theme-plain .masthead {
    grid-template-columns: 1fr;
  }
  .theme-plain h1,
  .theme-plain h2 {
    font-weight: 400;
  }
</style>
