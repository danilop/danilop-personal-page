---
import "../../runtime/audio-playback.css";
import "./audio-surface.css";
interface Props {
  href: string;
  framed?: boolean;
}
const { href, framed = true } = Astro.props;
---

<div class:list={["book-audio-link", { "audio-surface": framed }]}>
  <a class="audio-action icon-label-button" href={href}>
    <svg
      class="control-icon"
      aria-hidden="true"
      focusable="false"
      viewBox="0 0 24 24"
    >
      <path
        d="M4 14v-2a8 8 0 0 1 16 0v2M4 13h3v7H4zm13 0h3v7h-3z"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>
    <span>
      Open audiobook from here <span aria-hidden="true">→</span>
    </span>
  </a>
</div>
