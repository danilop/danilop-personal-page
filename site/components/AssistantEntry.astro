---
// Shown by runtime/enhance.ts only in browsers that may run an on-device model.
---

<p class="assistant-entry" data-assistant hidden>
  <button
    type="button"
    class="assistant-open"
    data-assistant-open
    aria-controls="assistant-panel"
    aria-expanded="false"
  >
    <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24">
      <path
        d="M4 5h16v10H9l-5 4z"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linejoin="round"
      ></path>
    </svg>
    <span>Ask about this page</span>
  </button>
</p>
<style>
  .assistant-entry {
    margin: 0 0 28px;
  }

  .assistant-open {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border: 0;
    background: none;
    padding: 4px 0;
    color: var(--blue);
    font: inherit;
    font-size: 15px;
    cursor: pointer;
  }

  .assistant-open svg {
    width: 18px;
    height: 18px;
  }

  .assistant-open:hover span {
    text-decoration: underline;
  }
</style>
