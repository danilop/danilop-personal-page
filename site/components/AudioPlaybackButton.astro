---
import { playbackIcons } from "../../runtime/audio-playback.js";
import "../../runtime/audio-playback.css";
interface Props {
  kind: "article" | "book";
  title: string;
  label?: string;
}
const { kind, title } = Astro.props;
const label =
  Astro.props.label ??
  (kind === "book" ? "Listen to this book" : "Listen to this article");
---

<button
  type="button"
  class="audio-playback-button icon-label-button"
  data-play={kind === "article" ? "" : undefined}
  data-book-play={kind === "book" ? "" : undefined}
  aria-label={`${label}: ${title}`}
  hidden
>
  <Fragment set:html={playbackIcons} />
  <span data-play-label>{label}</span>
</button>
