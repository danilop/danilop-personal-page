---
import { localPath, siteUrl } from "../../core/deployment.mjs";
import "@fontsource/inter/400.css";
import "@fontsource/inter/500.css";
import "@fontsource/newsreader/400.css";
import "@fontsource/newsreader/500.css";
import "@fontsource/newsreader/600.css";
import "@fontsource/newsreader/400-italic.css";
import "katex/dist/katex.min.css";
import { siteConfig } from "../../core/config";
import { themes } from "../../themes/registry";
import { site } from "../data";
import { loadEditions } from "../../core/editions";
import PostHog from "./posthog.astro";
const publishedEditions = (await loadEditions()).filter(
  (e) => e.status === "published",
);
const config = await siteConfig();
const {
  title = config.name,
  description = config.description,
  canonical = Astro.url.pathname,
  article,
  language = article?.language ?? "en",
} = Astro.props;
const Shell = themes[config.theme].Shell;
const url = siteUrl(canonical, config.url);
const socialImage =
  site.social?.pages[localPath(Astro.url.pathname)] ?? site.social?.default;
const imageUrl = socialImage ? siteUrl(socialImage.src, config.url) : undefined;
const locale = language.match(/^([a-z]{2,3})-([a-z]{2})(?:-|$)/i);
const previewLinks = site.authoring
  ? [
      ...site.collections
        .filter((c) => site.authoring!.collections.includes(c.id))
        .map((c) => ({ title: c.title, url: c.url })),
      ...site.authoring.pieces.flatMap((id) => {
        const a = site.articles.find((p) => p.id === id);
        if (a) return [{ title: a.title, url: a.url }];
        const c = site.collections.find((c) =>
          c.nodes.some((n) => n.pieceId === id),
        );
        const n = c?.nodes.find((n) => n.pieceId === id);
        return c && n ? [{ title: n.title, url: `${c.url}read/${n.id}/` }] : [];
      }),
    ]
  : [];
const isDraftPage =
  previewLinks.some((p) => p.url === Astro.url.pathname) ||
  site.collections.some(
    (c) =>
      site.authoring?.collections.includes(c.id) &&
      Astro.url.pathname.startsWith(c.url),
  );
const jsonLd = {
  "@context": "https://schema.org",
  "@type": article ? "BlogPosting" : "WebPage",
  name: title,
  headline: title,
  description,
  url,
  inLanguage: language,
  ...(imageUrl ? { image: imageUrl } : {}),
  author: { "@type": "Person", name: config.name },
  ...(article
    ? {
        datePublished: article.publishedAt,
        dateModified: article.updatedAt ?? article.publishedAt,
      }
    : {}),
};
---

<!doctype html>
<html lang={language} prefix="og: https://ogp.me/ns#">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title===config.name?`${config.name} — ${config.title}`:`${title} — ${config.name}`}</title>
    <meta name="description" content={description} />
    {site.isPreview && <meta name="robots" content="noindex,nofollow" />}
    <link rel="canonical" href={url} />
    <link rel="icon" href={site.icons.ico} sizes="16x16 32x32 48x48" />
    <link rel="icon" type="image/svg+xml" href={site.icons.svg} sizes="any" />
    <link rel="apple-touch-icon" sizes="180x180" href={site.icons.apple} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={config.title}
      href="/rss.xml"
    />
    <link rel="stylesheet" href="/theme-tokens.css" />
    {config.overrideCss && (
      <link rel="stylesheet" href="/theme-overrides.css" />
    )}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:site_name" content={config.title} />
    {locale && (
      <meta
        property="og:locale"
        content={`${locale[1].toLowerCase()}_${locale[2].toUpperCase()}`}
      />
    )}
    {socialImage && (
      <>
        <meta property="og:image" content={imageUrl} />
        <meta property="og:image:type" content={socialImage.type} />
        <meta property="og:image:width" content={String(socialImage.width)} />
        <meta property="og:image:height" content={String(socialImage.height)} />
        <meta property="og:image:alt" content={socialImage.alt} />
      </>
    )}
    {article?.publishedAt && (
      <meta property="article:published_time" content={article.publishedAt} />
    )}
    {article?.updatedAt && (
      <meta property="article:modified_time" content={article.updatedAt} />
    )}
    <meta
      name="twitter:card"
      content={socialImage ? "summary_large_image" : "summary"}
    />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {socialImage && (
      <>
        <meta name="twitter:image" content={imageUrl} />
        <meta name="twitter:image:alt" content={socialImage.alt} />
      </>
    )}
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(jsonLd).replaceAll("<", "\\u003c")}
    ></script>
  </head>
  <body>
    {site.authoring && (
      <aside class="authoring-notice" aria-label="Authoring preview">
        <strong>Local authoring preview</strong>
        <p>
          {isDraftPage ? "Unpublished draft. " : ""}Selected drafts are visible
          here only. Nothing has been published.
        </p>
        {previewLinks.length > 0 && (
          <details>
            <summary>Drafts in this preview</summary>
            <ul>
              {previewLinks.map((p) => (
                <li>
                  <a href={p.url}>{p.title}</a>
                </li>
              ))}
            </ul>
          </details>
        )}
        <small>
          Rebuild after edits. Missing article dates use {site.authoring.date}{" "}
          for this preview.
        </small>
      </aside>
    )}
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <Shell
      config={config}
      collectionsCount={site.collections.length + publishedEditions.length}
    >
      <slot />
    </Shell>
    {!site.authoring && <PostHog contentId={article?.id} />}
    <script>
      import "../../runtime/enhance";
    </script>
  </body>
</html>
<style>
  .authoring-notice {
    padding: 12px max(20px, calc((100vw - 1120px) / 2));
    background: #fff5da;
    border-bottom: 1px solid #baa876;
    color: #27231a;
    font:
      14px/1.5 system-ui,
      sans-serif;
  }

  .authoring-notice p {
    margin: 4px 0;
  }

  .authoring-notice summary {
    cursor: pointer;
  }

  .authoring-notice a {
    color: #164b88;
  }

  .authoring-notice ul {
    margin: 6px 0;
    padding-left: 22px;
  }
</style>
