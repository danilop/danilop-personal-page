---
import { localPath } from "../../core/deployment.mjs";
const pathname = localPath(Astro.url.pathname);
const { config, collectionsCount } = Astro.props;
const current = (prefix: string) =>
  pathname === prefix
    ? "page"
    : pathname.startsWith(prefix)
      ? "location"
      : undefined;
---

<header class="masthead">
  <div class="identity">
    <a class="name" href="/">
      {config.name}
    </a>
    <p>{config.title}</p>
  </div>
  <a class="portrait-link" href="/about/" aria-label="About Danilo Poccia">
    <img
      src="/brand/portrait.webp"
      width="178"
      height="157"
      alt={config.assets.portrait.alt}
      style={`object-fit:${config.assets.portrait.fit};object-position:${config.assets.portrait.position}`}
    />
  </a>
  <nav aria-label="Main navigation">
    <a href="/writing/" aria-current={current("/writing/")}>
      Writing
    </a>
    {collectionsCount > 0 && (
      <a
        href="/collections/"
        aria-current={
          current("/collections/") ??
          (pathname.startsWith("/books/") ? "location" : undefined)
        }
      >
        Collections & Books
      </a>
    )}
    <a href="/archive/" aria-current={current("/archive/")}>
      Earlier Work
    </a>
    <a href="/about/" aria-current={current("/about/")}>
      About
    </a>
  </nav>
</header>
