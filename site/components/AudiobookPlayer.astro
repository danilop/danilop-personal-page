---
import type { ListeningAudio } from "../../core/audiobook-excerpt";
import ListeningHeading from "./ListeningHeading.astro";
import AudioPlaybackButton from "./AudioPlaybackButton.astro";
import "./audio-surface.css";
import { audioClock } from "../../runtime/audiobook-progress";
interface Props {
  audiobook?: ListeningAudio;
}
const { audiobook: b } = Astro.props;
const map = b && {
  bookId: b.bookId,
  offset: b.offset ?? 0,
  scope: b.scope,
  listenLabel: b.listenLabel,
  title: b.title,
  author: b.author,
  hash: b.hash,
  segments: b.segments.map(({ id, placement, contentHash, label }) => ({
    id,
    placement,
    contentHash,
    label,
  })),
  audio: { duration: b.audio.duration, timings: b.audio.timings },
};
---

{b && (
  <section
    class="audiobook audio-surface"
    id={b.scope ? `audio-${b.scope}` : "audiobook"}
    data-audiobook
    aria-label={b.scope ? `Listen: ${b.title}` : "Book audiobook"}
  >
    <script
      type="application/json"
      data-book-map
      set:html={JSON.stringify(map).replace(/</g, "\\u003c")}
    />
    <ListeningHeading label={b.scope ? "Listen" : "Audiobook"} />
    <div class="book-audio-heading">
      <AudioPlaybackButton kind="book" title={b.title} label={b.listenLabel} />
      <span data-book-native>{b.listenLabel ?? "Listen to this book"}</span>
    </div>
    <p class="audio-edition">
      {b.preview
        ? "Private draft preview"
        : b.complete
          ? "Complete book"
          : "Published so far"}{" "}
      · {b.createdAt.slice(0, 10)} · {audioClock(b.audio.duration)} at 1×
    </p>
    {b.partial.length > 0 && <p>Includes a partially published chapter.</p>}
    {/* eslint-disable-next-line astro/jsx-a11y/media-has-caption -- Exact spoken transcript and text reading links are provided below. */}
    <audio
      controls
      preload="none"
      src={
        b.scope
          ? `${b.url}#t=${b.offset},${(b.offset ?? 0) + b.audio.duration}`
          : b.url
      }
      aria-label={`Audiobook of ${b.title}`}
    />
    <div data-book-controls hidden>
      <p data-book-position class="audio-position"></p>
      <label class="audio-seek">
        <span class="sr-only">Audiobook position</span>
        <input
          type="range"
          min="0"
          max={b.audio.duration}
          step="0.1"
          value="0"
          data-book-seek
        />
      </label>
      <div class="audio-buttons">
        <button type="button" data-book-back aria-label="Back 15 seconds">
          −15s
        </button>
        <button type="button" data-book-forward aria-label="Forward 15 seconds">
          +15s
        </button>
        <label>
          <span class="sr-only">Playback speed</span>
          <select data-book-speed aria-label="Playback speed">
            {[0.8, 1, 1.1, 1.2, 1.5, 2].map((v) => (
              <option value={v} selected={v === 1.1}>
                {v}×
              </option>
            ))}
          </select>
        </label>
      </div>
      <p data-book-time class="audio-edition"></p>
    </div>
    <p data-book-notice role="status"></p>
    <p data-book-error role="status" hidden>
      Audio could not be loaded.{" "}
      <button type="button" data-book-retry>
        Retry
      </button>{" "}
      Please try again later.
    </p>
    {!b.scope && (
      <p class="audio-download">
        <a href={b.url} download={b.filename}>
          Download audiobook (MP3)
        </a>{" "}
        <span>· {(b.audio.bytes / 1024 / 1024).toFixed(1)} MB</span>
      </p>
    )}
    <details>
      <summary>More listening options</summary>
      <p>
        {b.preview
          ? "This private recording includes draft material."
          : "This recording contains the material published so far."}{" "}
        Saved browser progress stays on this device. Downloads from the book
        page do not update automatically.
      </p>
      <details class="audio-transcript">
        <summary>Spoken transcript</summary>
        {b.segments.map((s) => (
          <p
            class:list={{
              "audio-heading": s.kind === "heading" || s.kind === "title",
            }}
          >
            {s.text}
          </p>
        ))}
      </details>
    </details>
  </section>
)}
<script>
  import "../../runtime/audiobook-player";
</script>
<style>
  .book-audio-heading,
  .audio-buttons {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  button:not(.audio-playback-button),
  select {
    font: inherit;
    color: inherit;
    background: transparent;
    border: 1px solid var(--hairline, #c9c9c3);
    border-radius: 4px;
    min-height: 44px;
    padding: 0.35rem 0.65rem;
    cursor: pointer;
  }

  .audio-edition,
  .audio-position {
    margin: 0.3rem 0;
    color: var(--muted, #586371);
    font-variant-numeric: tabular-nums;
  }

  .audio-position {
    margin-top: 1rem;
  }

  .audio-seek input,
  audio {
    width: 100%;
    min-height: 44px;
  }

  .audio-seek input {
    accent-color: var(--accent, #164b88);
  }

  summary {
    cursor: pointer;
    padding: 0.65rem 0;
    min-height: 44px;
  }

  .audio-download {
    margin: 0.8rem 0;
  }

  .audio-download span {
    font-size: 0.75rem;
  }

  .audio-transcript {
    max-height: 24rem;
    overflow: auto;
  }

  .audio-heading {
    font-weight: 600;
  }

  :focus-visible {
    outline: 2px solid var(--accent, #164b88);
    outline-offset: 3px;
  }

  [hidden] {
    display: none !important;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  @media (width<=520px) {
    .audio-buttons {
      gap: 0.25rem;
    }

    .audio-buttons button {
      padding: 0.35rem 0.5rem;
    }
  }
</style>
