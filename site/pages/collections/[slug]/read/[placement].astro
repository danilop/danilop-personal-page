---
import { readingLinks } from "../../../../../core/reading-links";
import Layout from "../../../../components/Layout.astro";
import { site } from "../../../../data";
import ReadingNavigation from "../../../../components/ReadingNavigation.astro";
import { readingContext } from "../../../../../core/reading-navigation";
export function getStaticPaths() {
  return site.collections.flatMap((c) =>
    c.nodes
      .filter((n) => n.kind === "piece")
      .map((n) => ({
        params: { slug: c.url.split("/")[2], placement: n.id },
        props: { c, n },
      })),
  );
}
const { c, n } = Astro.props;
const { parent, position, total } = readingContext(c, n.id);
const original = site.articles.find((p) => p.id === n.pieceId);
---

<Layout title={n.title} canonical={c.url} description={c.summary}>
  <article class="reading">
    <header class="article-heading">
      <p class="eyebrow">
        <a href={c.url}>{c.title}</a>
      </p>
      <h1>
        {n.number && `${n.number}. `}
        {n.title}
      </h1>
      {parent && (
        <p class="meta">
          In <a href={`${c.url}chapters/${parent.id}/`}>{parent.title}</a>
        </p>
      )}
      {c.ordered && (
        <p class="meta">
          Section {position} of {total}
        </p>
      )}
    </header>
    <div
      id={n.id}
      class="prose"
      set:html={readingLinks(n.html, c.url, [n.id])}
    />
    <ReadingNavigation collection={c} nodeId={n.id} />
    {original && (
      <p class="meta">
        <a href={original.url}>View standalone post</a>
      </p>
    )}
  </article>
</Layout>
