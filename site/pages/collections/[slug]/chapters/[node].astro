---
import { readingLinks } from "../../../../../core/reading-links";
import Layout from "../../../../components/Layout.astro";
import { site } from "../../../../data";
import ReadingNavigation from "../../../../components/ReadingNavigation.astro";
import { readingContext } from "../../../../../core/reading-navigation";
export function getStaticPaths() {
  return site.collections.flatMap((c) =>
    c.nodes
      .filter((n) => ["chapter", "appendix", "part"].includes(n.kind))
      .map((n) => ({
        params: { slug: c.url.split("/")[2], node: n.id },
        props: { c, n },
      })),
  );
}
const { c, n } = Astro.props;
const { children } = readingContext(c, n.id);
---

<Layout title={n.title} canonical={c.url} description={c.summary}>
  <article class="reading">
    <header class="article-heading">
      <p class="eyebrow">
        <a href={c.url}>{c.title}</a>
      </p>
      <h1>
        {n.number && `${n.number}. `}
        {n.title}
      </h1>
    </header>
    {children.map((child) => (
      <section id={child.id}>
        <h2>
          {child.number && `${child.number}. `}
          {child.title}
          {child.planned && " — Planned"}
        </h2>
        {child.kind === "piece" && (
          <p class="meta">
            <a href={`${c.url}read/${child.id}/`}>
              Read this section separately
            </a>
          </p>
        )}
        <div
          class="prose"
          set:html={readingLinks(
            child.html,
            c.url,
            children.map((x) => x.id),
          )}
        />
      </section>
    ))}
    <ReadingNavigation collection={c} nodeId={n.id} />
  </article>
</Layout>
