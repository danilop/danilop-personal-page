---
import { readingPlan } from "../../../../../core/reading-structure";
import {
  readingLinks,
  readingHeadings,
} from "../../../../../core/reading-links";
import Layout from "../../../../components/Layout.astro";
import { site } from "../../../../data";
import ReadingNavigation from "../../../../components/ReadingNavigation.astro";
import NarrationPlayer from "../../../../components/NarrationPlayer.astro";
import { readingContext } from "../../../../../core/reading-navigation";
export function getStaticPaths() {
  return site.collections.flatMap((c) =>
    c.nodes
      .filter((n) => ["chapter", "appendix", "part"].includes(n.kind))
      .map((n) => ({
        params: { slug: c.url.split("/")[2], node: n.id },
        props: { c, n },
      })),
  );
}
const { c, n } = Astro.props;
const plan = readingPlan(c.nodes, { rootId: n.id });
const { children } = readingContext(c, n.id);
---

<Layout title={n.title} canonical={c.url} description={c.summary}>
  <article class="reading">
    <header class="article-heading">
      <p class="eyebrow">
        <a href={c.url}>{c.title}</a>
      </p>
      <h1>
        {n.number && `${n.number}. `}
        {n.title}
      </h1>
    </header>
    {c.audiobook && (
      <p>
        <a href={`${c.url}?listen=${encodeURIComponent(n.id)}#audiobook`}>
          Listen from here in the audiobook
        </a>
      </p>
    )}
    {children.map((child) => {
      const format = plan.get(child.id)!;
      const Heading = `h${format.headingLevel ?? 2}` as
        "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
      return (
        <section
          id={child.id}
          class:list={["prose", { "reading-section": !format.omit }]}
        >
          {format.headingLevel && (
            <Heading>
              {child.number && `${child.number}. `}
              {child.title}
              {child.planned && " — Planned"}
            </Heading>
          )}
          {child.kind === "piece" && !format.omit && (
            <p class="meta">
              <a href={`${c.url}read/${child.id}/`}>
                Read this section separately
              </a>
            </p>
          )}
          <div class="narration-container">
            <NarrationPlayer narration={child.narration} title={child.title} />
          </div>
          <div
            set:html={readingLinks(
              readingHeadings(child.html, format.bodyOffset),
              c.url,
              children.map((x) => x.id),
            )}
          />
        </section>
      );
    })}
    <ReadingNavigation collection={c} nodeId={n.id} />
  </article>
</Layout>
